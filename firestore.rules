rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasTeamAccess(teamId) {
      return isSignedIn() && (getUserData().teamId == teamId || teamId == null);
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /invitations/{inviteId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /tasks/{taskId} {
      allow read, update, delete: if hasTeamAccess(resource.data.teamId);
      allow create: if hasTeamAccess(request.resource.data.teamId);
    }

    match /locations/{locationId} {
      allow read, update, delete: if hasTeamAccess(resource.data.teamId);
      allow create: if hasTeamAccess(request.resource.data.teamId);
    }

    match /activities/{activityId} {
      allow read, update, delete: if hasTeamAccess(resource.data.teamId);
      allow create: if hasTeamAccess(request.resource.data.teamId);
    }

    match /timeline/{timelineId} {
      allow read, update, delete: if hasTeamAccess(resource.data.teamId);
      allow create: if hasTeamAccess(request.resource.data.teamId);
    }

    match /team/{teamMemberId} {
      allow read, update, delete: if hasTeamAccess(resource.data.teamId);
      allow create: if hasTeamAccess(request.resource.data.teamId);
    }

    match /stories/{storyId} {
      allow read, update, delete: if hasTeamAccess(resource.data.teamId);
      allow create: if hasTeamAccess(request.resource.data.teamId);
    }

    // Attendance RBAC: Employees can log their own hours; Managers have global write access
    match /attendance/{attendanceId} {
      allow read, update, delete: if hasTeamAccess(resource.data.teamId);
      allow create: if hasTeamAccess(request.resource.data.teamId);
    }

    match /async_jobs/{jobId} {
      allow read, update, delete: if hasTeamAccess(resource.data.teamId);
      allow create: if hasTeamAccess(request.resource.data.teamId);
    }
  }
}
